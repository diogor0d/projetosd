{
	"info": {
		"_postman_id": "googol-api-collection",
		"name": "Googol Search Engine API",
		"description": "Collection of API endpoints for testing the Googol distributed search engine",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Search",
			"item": [
				{
					"name": "Search - Page 0",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://localhost:8081/api/search?q=java&page=0",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "java",
									"description": "Search query terms"
								},
								{
									"key": "page",
									"value": "0",
									"description": "Page number (0-indexed)"
								}
							]
						},
						"description": "Search for pages containing the query terms. Returns paginated results with metadata."
					},
					"response": []
				},
				{
					"name": "Search - Multiple Terms",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://localhost:8081/api/search?q=distributed systems&page=0",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"search"
							],
							"query": [
								{
									"key": "q",
									"value": "distributed systems"
								},
								{
									"key": "page",
									"value": "0"
								}
							]
						},
						"description": "Search with multiple terms"
					},
					"response": []
				}
			],
			"description": "Search endpoints for querying indexed pages"
		},
		{
			"name": "Indexing",
			"item": [
				{
					"name": "Index URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"url\": \"https://en.wikipedia.org/wiki/Distributed_computing\"\n}"
						},
						"url": {
							"raw": "https://localhost:8081/api/index",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"index"
							]
						},
						"description": "Submit a URL for high-priority indexing"
					},
					"response": []
				},
				{
					"name": "Index HackerNews Stories",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "query",
									"value": "python",
									"description": "Search terms to filter HN stories",
									"type": "text"
								},
								{
									"key": "maxUrls",
									"value": "10",
									"description": "Maximum number of stories to index (default: 10)",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "https://localhost:8081/index-hackernews",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"index-hackernews"
							]
						},
						"description": "Index HackerNews top stories containing specific terms. Processes asynchronously and returns immediately."
					},
					"response": []
				}
			],
			"description": "Endpoints for submitting URLs and HackerNews stories for indexing"
		},
		{
			"name": "HackerNews API",
			"item": [
				{
					"name": "List HackerNews Stories (local)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://localhost:8081/api/hackernews/stories?query=python&maxStories=10",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"hackernews",
								"stories"
							],
							"query": [
								{
									"key": "query",
									"value": "python",
									"description": "Terms to filter the HackerNews top stories (local proxy)"
								},
								{
									"key": "maxStories",
									"value": "10",
									"description": "Maximum number of stories to return (local proxy)"
								}
							]
						},
						"description": "Fetches HackerNews stories filtered by your local service (/api/hackernews/stories) — this calls your server's filtering/indexing logic (local)."
					},
					"response": []
				},
				{
					"name": "Index HackerNews Stories (local)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"machine learning\",\n    \"maxUrls\": 15\n}"
						},
						"url": {
							"raw": "https://localhost:8081/api/hackernews/index",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"hackernews",
								"index"
							]
						},
						"description": "Triggers background indexing of HackerNews stories using your local service (/api/hackernews/index). This is a local endpoint that enqueues indexing jobs."
					},
					"response": []
				}
			],
			"description": "Programmatic access to HackerNews story discovery and indexing"
		},
		{
			"name": "System Stats",
			"item": [
				{
					"name": "Get System Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://localhost:8081/api/stats",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"stats"
							]
						},
						"description": "Get system statistics including indexed pages, active barrels, and top searches"
					},
					"response": []
				}
			],
			"description": "System monitoring and statistics endpoints"
		},
		{
			"name": "Page Analysis",
			"item": [
				{
					"name": "Get Incoming Links",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://localhost:8081/api/links-to?url=https://example.com",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"links-to"
							],
							"query": [
								{
									"key": "url",
									"value": "https://example.com",
									"description": "URL to find incoming links for"
								}
							]
						},
						"description": "Get list of pages that link to a specific URL"
					},
					"response": []
				}
			],
			"description": "Endpoints for analyzing page relationships and links"
		},
		{
			"name": "AI Features",
			"item": [
				{
					"name": "AI Analysis",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"query\": \"machine learning\",\n    \"results\": [\n        {\n            \"url\": \"https://example.com/ml-intro\",\n            \"title\": \"Introduction to Machine Learning\",\n            \"snippet\": \"Machine learning is a subset of artificial intelligence...\"\n        },\n        {\n            \"url\": \"https://example.com/ml-algorithms\",\n            \"title\": \"Common ML Algorithms\",\n            \"snippet\": \"This article covers the most popular machine learning algorithms...\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "https://localhost:8081/api/ai-analysis",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"ai-analysis"
							]
						},
						"description": "Generate AI-powered contextual analysis of search results (requires OpenAI API key)"
					},
					"response": []
				},
				{
					"name": "Spell Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://localhost:8081/api/spell-check?q=machne learning",
							"protocol": "https",
							"host": [
								"localhost"
							],
							"port": "8081",
							"path": [
								"api",
								"spell-check"
							],
							"query": [
								{
									"key": "q",
									"value": "machne learning",
									"description": "Query to spell-check"
								}
							]
						},
						"description": "Check spelling and get suggestions for query terms"
					},
					"response": []
				}
			],
			"description": "AI-powered features including analysis and spell checking"
		}
		,
		{
			"name": "OpenRouter",
			"item": [
				{
					"name": "OpenRouter (local proxy) - Test Prompt",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"prompt\": \"Summarize the state of distributed search engines in 3 sentences.\",\n    \"maxTokens\": 200\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/openrouter/test"
						},
						"description": "Invoke the local OpenRouter proxy endpoint on your Spring app ({{baseUrl}}/api/openrouter/test). Requires local proxy to be running."
					},
					"response": []
				}
			],
			"description": "Direct OpenRouter invocation for debugging LLM connectivity"
		}
		,
		{
			"name": "External APIs",
			"item": [
				{
					"name": "HackerNews - Top Stories (remote)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://hacker-news.firebaseio.com/v0/topstories.json",
							"protocol": "https",
							"host": [
								"hacker-news",
								"firebaseio",
								"com"
							],
							"path": [
								"v0",
								"topstories.json"
							]
						},
						"description": "Fetch HackerNews top story IDs directly from the public API (remote) — returns an array of story IDs."
					},
					"response": []
				},
				{
					"name": "HackerNews - Item by ID (remote)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "https://hacker-news.firebaseio.com/v0/item/8863.json",
							"protocol": "https",
							"host": [
								"hacker-news",
								"firebaseio",
								"com"
							],
							"path": [
								"v0",
								"item",
								"8863.json"
							]
						},
						"description": "Fetch a single HackerNews item (story/comment) by ID from the public API (remote) — replace the ID in the path as needed"
					},
					"response": []
				},
				{
					"name": "OpenRouter (remote) - Chat Completion",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{openrouter_api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model\": \"meta-llama/llama-3.1-8b-instruct:free\",\n  \"messages\": [{ \"role\": \"user\", \"content\": \"Summarize distributed search engines in 2 sentences.\" }],\n  \"max_tokens\": 200,\n  \"temperature\": 0.7\n}"
						},
						"url": {
							"raw": "https://openrouter.ai/api/v1/chat/completions",
							"protocol": "https",
							"host": [
								"openrouter",
								"ai"
							],
							"path": [
								"api",
								"v1",
								"chat",
								"completions"
							]
						},
						"description": "Call OpenRouter chat completions directly (remote). Set your OpenRouter API key in Postman as the variable `openrouter_api_key`."
					},
					"response": []
				}
			],
			"description": "Direct calls to public external APIs (HackerNews, OpenRouter) for testing"
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		}
	]
}
